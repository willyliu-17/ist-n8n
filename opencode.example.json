{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "n8n-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "n8n-mcp@latest"
      ],
      "enabled": true,
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "http://localhost:5678",
        "N8N_API_KEY": "your_local_api_key_here",
        "WEBHOOK_SECURITY_MODE": "moderate"
      }
    }
  },
  "permission": {
    "bash": {
      "*": "ask"
    }
  }
}