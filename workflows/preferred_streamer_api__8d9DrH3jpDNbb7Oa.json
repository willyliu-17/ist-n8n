    {
      "parameters": {
        "jsCode": "\nconst emojiMap = JSON.parse( $input.first().json.data);\n\n\nconst inputText = $('Webhook').first().json.body.openID || ''; \n\n// 用 regex 將 :emoji_name: 換成真實 emoji\nfunction replaceColonEmoji(text, map) {\n  return text.replace(/:([a-zA-Z0-9_+-]+):/g, (match, name) => {\n    return map[name] || match;\n  });\n}\n\nconst replaced = replaceColonEmoji(inputText, emojiMap);\n\nreturn [\n  {\n    json: {\n      openID: replaced\n    }\n  }\n];"
      },
