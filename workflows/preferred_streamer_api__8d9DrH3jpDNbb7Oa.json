    {
      "parameters": {
        "jsCode": "\nlet output = '';\n\nfor (const item of $input.all()) {\n  const openID = item.json.openID;\n  const day = item.json.day;\n  const point = item.json.p;\n  output += `openID: \\`${openID}\\` IP: \\`${day}\\`  IP: \\`${point}\\`\\n`;\n}\n\nreturn [\n  {\n    json: {\n      text: output\n    }\n  }\n];\n\n"
      },
