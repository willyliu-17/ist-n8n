        "sqlQuery": "   with raw01 as (\n    SELECT\n      receiverUserID,sum(point) as p\n    FROM\n      `media17-1119.MySQLPartition.GiftBox` \n    WHERE\n      utcTimestamp >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 120 DAY) and senderUserID='{{ $json.userID }}' group by receiverUserID order by p desc limit 20\n  )\n  select openID,p from `media17-1119.mongodb.User` u inner join raw01 on u.userID=raw01.receiverUserID",
