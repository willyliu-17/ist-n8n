        "sqlQuery": "DECLARE start_timestamp TIMESTAMP;\nDECLARE end_timestamp TIMESTAMP;\n\nSET end_timestamp = TIMESTAMP_ADD(TIMESTAMP_SECONDS(1769965459), INTERVAL 5 MINUTE);\nSET start_timestamp = TIMESTAMP_SUB(TIMESTAMP_SECONDS(1769959969), INTERVAL 5 MINUTE);\n\n/* 第一步：先把 JSON 裡面的 title 拔出來變成一個實體欄位 */\nWITH ProcessedLogs AS (\n  SELECT\n    DATETIME(timestamp, \"Asia/Taipei\") as UTCp8,\n    Type,\n    JSON_EXTRACT_SCALAR(Log, '$.time') as LocalTime,\n    JSON_EXTRACT_SCALAR(Log, '$.title') AS title, -- 提取為 title\n    Log,\n    triggerUserID,\n    deviceType,\n    ip,\n    region,\n    deviceID,\n    version,\n    timestamp\n  FROM\n    `media17-1119.BackendEvent.IstStreamerEventLog`\n  WHERE\n    timestamp BETWEEN start_timestamp AND end_timestamp\n    AND CAST(triggerUserID AS STRING) = \"9a9a3b51-2129-4ae7-a5e8-b0449825cb4d\"\n)\n\n/* 第二步：現在這裡可以自由使用 title 這個欄位了 */\nSELECT * FROM ProcessedLogs\nWHERE  {{ $fromAI('query', '例如 title = \"Poor CDN Connection\"') }} \nORDER BY\n  UTCp8 ASC;",
