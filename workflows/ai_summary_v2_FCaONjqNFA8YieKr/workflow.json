              "id": "6e5495e6-d669-4491-b899-92113cf42895",
              "name": "summary",
              "value": "={{ \n  (() => {\n    const rawText = $json.output || $json.response || $json.text || ($json.candidates && $json.candidates[0] && $json.candidates[0].content && $json.candidates[0].content.parts && $json.candidates[0].content.parts[0] && $json.candidates[0].content.parts[0].text);\n\n    if (!rawText) {\n      return { error: true, message: 'Empty model output', raw: $json };\n    }\n\n    if (typeof rawText === 'object') {\n      const normalized = Array.isArray(rawText) ? rawText[0] : rawText;\n      if (normalized && typeof normalized === 'object' && normalized.output && normalized.output.report) {\n        return normalized.output;\n      }\n      return normalized;\n    }\n\n    const trimmed = String(rawText).trim();\n    const firstArray = trimmed.indexOf('[');\n    const firstObject = trimmed.indexOf('{');\n    const startIndex = firstArray === -1 ? firstObject : (firstObject === -1 ? firstArray : Math.min(firstArray, firstObject));\n\n    if (startIndex === -1) {\n      return { error: true, message: 'No JSON start found', rawText: trimmed };\n    }\n\n    const jsonText = trimmed.slice(startIndex);\n\n    let parsed;\n    try {\n      parsed = JSON.parse(jsonText);\n    } catch (error) {\n      return { error: true, message: 'Invalid JSON', rawText: trimmed };\n    }\n\n    const normalized = Array.isArray(parsed) ? parsed[0] : parsed;\n    if (normalized && typeof normalized === 'object' && normalized.output && normalized.output.report) {\n      return normalized.output;\n    }\n\n    return normalized;\n  })()\n}}",
              "type": "object"
