={{ (() => { const source = $('Query Logs Loop').item.json; const error = $json.error; const errorMessage = typeof error === 'string' ? error : error?.message; return { streamID: source.streamID, channel: source.channel, target_thread_ts: source.target_thread_ts, ok: false, failedNode: String(error?.node?.name || error?.nodeName || $json.node?.name || 'Query Steam Logs v3').slice(0, 100), errorMessage: String(errorMessage || $json.message || 'Query Logs child failed').slice(0, 500) }; })() }}